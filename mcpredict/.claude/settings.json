{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "MCPREDICT_HOME=/Users/toor/hackerton/devlop2/.mcpredict /Users/toor/hackerton/devlop2/bin/mcpredict pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "MCPREDICT_HOME=/Users/toor/hackerton/devlop2/.mcpredict /Users/toor/hackerton/devlop2/bin/mcpredict post",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
